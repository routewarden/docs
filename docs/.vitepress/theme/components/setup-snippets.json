    {
      "filename": "nginx.conf",
      "lang": "nginx",
      "code": "init_by_lua_block {\n    local routewarden = require(\"resty.routewarden\")\n    warden = routewarden.new({\n        enabled = true,\n        enable_default_patterns = true\n    })\n}\n\nserver {\n    listen 80;\n    server_name example.com;\n\n    access_by_lua_block {\n        warden:check()\n    }\n\n    location / {\n        proxy_pass http://localhost:8080;\n    }\n}",
